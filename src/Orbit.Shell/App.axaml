<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orbit.Shell.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- Orbit atmosphere: cool slate mist (agent desktop, not SaaS purple / cream clay). -->
        <Color x:Key="OrbitTintColor">#C9D4E3</Color>
        <SolidColorBrush x:Key="OrbitFallbackBg">#E4EAF2</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitGlass">#B8FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitGlassStrong">#D6FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitGlassSoft">#66FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitGlassStroke">#59FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitGlassStrokeSoft">#33A0AEC0</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitSidebarBg">#99F4F7FB</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitMainBg">#00FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitChatWell">#55FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitRightBg">#99F4F7FB</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitBorder">#33A0AEC0</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitMuted">#5C6675</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitSubtle">#7A8494</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitInk">#1A2330</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitUserBubble">#CCEEF2F8</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitComposerBg">#E6FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitApprovalBg">#E6FFF8E8</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitApprovalBorder">#CCE0C070</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitAccent">#1A2330</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitLink">#2B5EA8</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitChipBg">#B8EEF2F8</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitSplit">#00000000</SolidColorBrush>
        <SolidColorBrush x:Key="OrbitSplitHover">#40A0AEC0</SolidColorBrush>
        <ExperimentalAcrylicMaterial x:Key="OrbitAcrylicShell"
                                     BackgroundSource="Digger"
                                     TintColor="{StaticResource OrbitTintColor}"
                                     TintOpacity="0.62"
                                     MaterialOpacity="0.72" />
        <ExperimentalAcrylicMaterial x:Key="OrbitAcrylicPanel"
                                     BackgroundSource="Digger"
                                     TintColor="#E8EEF5"
                                     TintOpacity="0.78"
                                     MaterialOpacity="0.82" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource OrbitInk}" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#A8FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="ListBox.trajectory ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.trajectory ListBoxItem:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="ListBox.trajectory ListBoxItem:selected">
            <Setter Property="Background" Value="#B8FFFFFF" />
        </Style>
        <Style Selector="ListBox.trajectory ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#D0FFFFFF" />
        </Style>
        <Style Selector="TabControl.trace-detail">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OrbitMuted}" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource OrbitInk}" />
        </Style>
        <Style Selector="Button.view-mode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource OrbitMuted}" />
        </Style>
        <Style Selector="Button.view-mode:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Button.view-mode.view-mode-active">
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource OrbitInk}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource OrbitAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#2C3A4E" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource OrbitInk}" />
            <Setter Property="SelectionBrush" Value="#332B5EA8" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.new-chat">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OrbitInk}" />
        </Style>
        <Style Selector="Button.new-chat:pointerover">
            <Setter Property="Background" Value="{StaticResource OrbitGlassStrong}" />
        </Style>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="{StaticResource OrbitGlassSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
        </Style>
        <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.composer:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.composer-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OrbitMuted}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.composer-icon:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource OrbitInk}" />
        </Style>
        <Style Selector="Button.composer-send">
            <Setter Property="Background" Value="{StaticResource OrbitAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.composer-send:pointerover">
            <Setter Property="Background" Value="#2C3A4E" />
        </Style>
        <Style Selector="Button.composer-send:disabled">
            <Setter Property="Background" Value="#B8C0CC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.composer-send.run-busy">
            <Setter Property="Background" Value="{StaticResource OrbitAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsEnabled" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.run-spin">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0" />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.run-busy-banner">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 8 28 0 #14001A2E" />
        </Style>
        <Style Selector="Border.glass-composer">
            <Setter Property="Background" Value="{StaticResource OrbitComposerBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 8 28 0 #14001A2E" />
        </Style>
        <Style Selector="Border.glass-chip">
            <Setter Property="Background" Value="{StaticResource OrbitGlassSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="GridSplitter.orbit-split">
            <Setter Property="Background" Value="{StaticResource OrbitSplit}" />
            <Setter Property="Width" Value="8" />
        </Style>
        <Style Selector="GridSplitter.orbit-split:pointerover">
            <Setter Property="Background" Value="{StaticResource OrbitSplitHover}" />
        </Style>
        <Style Selector="ComboBox.composer-model">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource OrbitMuted}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.composer-model /template/ TextBox#PART_EditableTextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.composer-model:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.chat-activity">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Expander.chat-activity /template/ ToggleButton#PART_toggle">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.cap-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander.cap-section /template/ ToggleButton#PART_toggle">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{StaticResource OrbitGlassSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitGlassStrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Expander.cap-section /template/ ToggleButton#PART_toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
        </Style>
        <Style Selector="Expander.cap-section:expanded /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{StaticResource OrbitGlass}" />
        </Style>
        <!-- Compact capability toggles — no On/Off caption. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="18" />
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
